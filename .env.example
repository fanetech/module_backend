# Server Configuration
PORT=3000
WS_PORT=3001

# External API Configuration
EXTERNAL_API_URL=https://api-epm.example.com

# CORS
WS_CORS_ORIGIN=http://localhost:4200

# Environment
NODE_ENV=development

# Logging
LOG_LEVEL=debug

# API Timeout
API_TIMEOUT=30000

# Retry Configuration
API_RETRY_ATTEMPTS=3
